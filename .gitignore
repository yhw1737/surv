# Asset meta data for ignored folders
!/[Aa]ssets/**/*.meta

# Never commit these
/Assets/AssetStoreTools*
/Assets/Plugins/Editor/JetBrains*
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
