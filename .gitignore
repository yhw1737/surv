sysinfo.txt

# Crash reports
crashlytics-build.properties

# Built players
*.apk
*.aab
*.unitypackage
*.app

# OS
.DS_Store
Thumbs.db

# World state — SQLite is runtime data, never source
*.db
*.db-shm
*.db-wal

# Dev-reference diagrams — local only, not a game asset
/profession-flow.svg
